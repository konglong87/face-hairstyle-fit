{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_status": {
      "const": "exploratory_case_review"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "anchors": {
            "type": "object",
            "properties": {
              "1": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "3": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "5": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "1",
              "3",
              "5"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "anchors"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "family",
              "expression",
              "recipe"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "cues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "ranges": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "plan": {
            "type": "object",
            "properties": {
              "hair": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1
              },
              "makeup": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1
              },
              "outfit": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1
              }
            },
            "required": [
              "hair",
              "makeup",
              "outfit"
            ],
            "additionalProperties": false
          },
          "cautions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "definition",
          "cues",
          "ranges",
          "plan",
          "cautions",
          "families"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "version",
    "evidence_status",
    "limitations",
    "dimensions",
    "styles"
  ],
  "additionalProperties": false
}
