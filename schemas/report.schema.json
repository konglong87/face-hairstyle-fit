{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "ready",
        "provisional",
        "needs_input"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "role": {
            "enum": [
              "user_photo",
              "reference",
              "expected_effect",
              "unknown"
            ]
          },
          "face_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "target_selected": {
            "type": "boolean"
          },
          "issues": {
            "type": "array",
            "items": {
              "enum": [
                "caption_present",
                "role_unknown",
                "filter_uncertain",
                "lighting_uncertain",
                "blur",
                "occluded",
                "extreme_pose",
                "no_face",
                "multiple_faces",
                "preferences_missing"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "role",
          "face_count",
          "target_selected",
          "issues"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "image_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "scope": {
            "enum": [
              "face",
              "hair",
              "makeup",
              "outfit"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "id",
          "image_id",
          "scope",
          "description",
          "evidence",
          "confidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "presentation_dimensions": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "liked_styles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "disliked_styles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": [
        "liked_styles",
        "disliked_styles",
        "constraints"
      ],
      "additionalProperties": false
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "expression_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "tradeoffs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "plan": {
            "type": "object",
            "properties": {
              "hair": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "propose",
                      "skip"
                    ]
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 0
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "status",
                  "actions",
                  "reason"
                ],
                "additionalProperties": false
              },
              "makeup": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "propose",
                      "skip"
                    ]
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 0
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "status",
                  "actions",
                  "reason"
                ],
                "additionalProperties": false
              },
              "outfit": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "propose",
                      "skip"
                    ]
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 0
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "status",
                  "actions",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "hair",
              "makeup",
              "outfit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "family_id",
          "expression_id",
          "recipe_id",
          "evidence_ids",
          "rationale",
          "tradeoffs",
          "plan"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "cost": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "reversible": {
            "type": "boolean"
          }
        },
        "required": [
          "action",
          "why",
          "cost",
          "reversible"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "status",
    "summary",
    "images",
    "observations",
    "presentation_dimensions",
    "preferences",
    "recommendations",
    "experiments",
    "uncertainties",
    "questions",
    "limitations"
  ],
  "additionalProperties": false
}
